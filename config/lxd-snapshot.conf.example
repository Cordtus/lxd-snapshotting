# LXD snapshotting configuration.
#
# Copy to /etc/lxd-snapshot.conf and edit for the target host.
# This file is sourced by bash; keep values quoted when they contain spaces.

# Optional LXC remote name without a trailing colon.
# Leave empty to use the default local LXD connection.
LXD_REMOTE=""

# LXD project to operate in.
LXD_PROJECT="default"

# Snapshot instances by name, or use "all" for every instance in the project.
SNAPSHOT_INSTANCES=1
INSTANCE_NAMES="all"

# Instance disk volume mode passed to `lxc snapshot --disk-volumes`.
# Valid values are "root" and "all-exclusive".
SNAPSHOT_DISK_VOLUMES="root"

# Snapshot custom storage volumes separately.
SNAPSHOT_CUSTOM_VOLUMES=0
CUSTOM_VOLUME_POOLS=""
CUSTOM_VOLUME_NAMES="all"

# Snapshot naming and retention.
SNAPSHOT_PREFIX="auto"
RETENTION_DAYS=7

# Create snapshots and prune old snapshots. Disable either side if needed.
CREATE_SNAPSHOTS=1
PRUNE_OLD=1

# Set to 1 to print commands without changing LXD state.
DRY_RUN=0
