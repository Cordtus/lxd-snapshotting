# Builder finalizer config.
# Copy to /etc/cosmos-snapshot-finalizer.env in snap-builder.

# Chain directory/archive prefix.
CHAIN="examplechain"

# Packages ${INGEST_ROOT}/${CHAIN}/${SOURCE_SUBDIR}.
INGEST_ROOT="/ingest"
SOURCE_SUBDIR="data"

# Publishes under ${PUBLIC_ROOT}/${CHAIN}.
PUBLIC_ROOT="/snapshots"

# Archive format.
COMPRESSION="zstd"
ZSTD_LEVEL=8

# Retention: one completed managed archive per chain.

# Optional sidecar JSON metadata.
HEIGHT=""
APP_VERSION=""
PRUNING=""

# Path to the node data dir under SOURCE_SUBDIR.
VALIDATION_DATA_SUBDIR="."

# Required DB dirs.
REQUIRED_DB_DIRS="application.db blockstore.db state.db"

# Each required DB dir needs one marker.
DB_MARKER_PATTERNS="CURRENT MANIFEST-* *.sst *.ldb"

# Refuse package while any marker exists.
PARTIAL_MARKERS=".transfer-in-progress .rsync-partial .uploading .incomplete"

# Extra excludes relative to ${INGEST_ROOT}/${CHAIN}.
EXTRA_EXCLUDES=""

# Print only.
DRY_RUN=0
