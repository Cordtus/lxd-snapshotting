# Builder-side finalizer configuration.
#
# Copy to /etc/cosmos-snapshot-finalizer.env inside the snap-builder container.

# Chain identifier used for input/output directory names and archive names.
CHAIN="examplechain"

# Ingest volume root. The finalizer packages ${INGEST_ROOT}/${CHAIN}/${SOURCE_SUBDIR}.
INGEST_ROOT="/ingest"
SOURCE_SUBDIR="data"

# Public output volume root. The finalizer publishes under ${PUBLIC_ROOT}/${CHAIN}.
PUBLIC_ROOT="/snapshots"

# Archive format. zstd is recommended for public snapshots. gzip is useful
# for minimal dependency environments and tests.
COMPRESSION="zstd"
ZSTD_LEVEL=8

# Retention is fixed to one completed managed archive per chain. Older managed
# archives are pruned only after the new archive validates and publishes.

# Optional metadata included in the sidecar JSON.
HEIGHT=""
APP_VERSION=""
PRUNING=""

# Path, relative to ${INGEST_ROOT}/${CHAIN}/${SOURCE_SUBDIR}, where the node
# data directory lives. Keep "." when SOURCE_SUBDIR already points at data.
VALIDATION_DATA_SUBDIR="."

# Required DB directories under VALIDATION_DATA_SUBDIR.
REQUIRED_DB_DIRS="application.db blockstore.db state.db"

# At least one of these marker patterns should exist in every required DB dir.
DB_MARKER_PATTERNS="CURRENT MANIFEST-* *.sst *.ldb"

# Refuse to package if any of these marker files exist under ${INGEST_ROOT}/${CHAIN}.
PARTIAL_MARKERS=".transfer-in-progress .rsync-partial .uploading .incomplete"

# Extra paths to exclude from the archive, relative to ${INGEST_ROOT}/${CHAIN}.
# The finalizer always excludes validator state and common key material.
EXTRA_EXCLUDES=""

# Print actions without writing archives or changing latest symlinks.
DRY_RUN=0
