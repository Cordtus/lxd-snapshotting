# Source-side upload configuration.
#
# The source path must be a consistent database view, not a live mutating
# Tendermint database directory.

CHAIN="examplechain"

# Path to the consistent source database directory. This directory is rsynced
# into ${REMOTE_INGEST_ROOT}/${CHAIN}/data on the builder.
SOURCE_PATH="/mnt/examplechain-snapshot/data"

# SSH target for the builder over the VPN-bound host proxy.
BUILDER_SSH="snapupload@snapshot-builder.example"
BUILDER_SSH_PORT=2222
SSH_OPTIONS="-o BatchMode=yes"

# Builder ingest path and finalizer command.
REMOTE_INGEST_ROOT="/ingest"
REMOTE_COMMAND="cosmos-snapshot-remote"

# Optional local label. Production authorization should come from the builder's
# forced-command SSH key, not from a client-supplied value.
CLIENT_ID=""

# Rsync behavior.
RSYNC_DELETE=1
RSYNC_EXTRA_ARGS="--numeric-ids"

# Trigger builder-side finalization after a successful rsync.
RUN_FINALIZER=1

# Print commands without transferring or running remote commands.
DRY_RUN=0
