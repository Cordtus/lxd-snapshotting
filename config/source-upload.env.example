# Source-side upload config. Install the filled version at
# /etc/cosmos-snapshot/source-upload.env.
#
# The script stops the node, stages allowed DB dirs into STAGING_PATH, restarts
# the node, then uploads STAGING_PATH by rsync or one-time bootstrap tar.

CHAIN="examplechain"

# Live node home and systemd service. DATA_SUBDIR is usually "data".
NODE_HOME="~/.genesisd"
DATA_SUBDIR="data"
SERVICE_NAME="examplechain.service"
SYSTEMCTL_COMMAND="systemctl"

# Separate local or mounted path. Rsync updates it in place before upload.
STAGING_PATH="/var/tmp/examplechain-stage"

# Validation and staging policy. Only these public DB dirs are copied.
REQUIRED_DB_DIRS="application.db blockstore.db state.db"
STAGE_DB_DIRS="application.db blockstore.db state.db evidence.db tx_index.db"
DB_MARKER_PATTERNS="CURRENT MANIFEST-* *.sst *.ldb"
LOCAL_RSYNC_EXTRA_ARGS="--numeric-ids"

# Builder SSH over the router VPN. Do not expose the builder directly.
BUILDER_SSH="snapupload@snapshot-builder.vpn"
BUILDER_SSH_PORT=2222
SSH_OPTIONS="-o BatchMode=yes"

# Restricted builder command. Builder paths are not client config.
REMOTE_COMMAND="cosmos-snapshot-remote"

# Optional local label. Production identity comes from forced-command SSH.
CLIENT_ID=""

# Rsync behavior.
RSYNC_DELETE=1
RSYNC_EXTRA_ARGS="--numeric-ids"

# Post-transfer checksum dry-run catches drift.
VERIFY_REMOTE_RSYNC=1

# Add --checksum to the transfer itself. Slower.
RSYNC_CHECKSUM=0

# Initial seed mode. Use once for an empty remote ingest path.
BOOTSTRAP_UPLOAD=0

# Finalize after upload.
RUN_FINALIZER=1

# Print only.
DRY_RUN=0

# Optional systemd OnCalendar value for the timer docs/UI.
UPLOAD_SCHEDULE="Mon,Thu *-*-* 03:15:00"
