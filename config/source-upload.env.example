# Source-side upload configuration.
#
# The script briefly stops the local service, copies only public node database
# directories into STAGING_PATH, restarts the service, then rsyncs STAGING_PATH
# to the builder.

CHAIN="examplechain"

# Live Tendermint/CometBFT data directory and systemd service to stop while
# staging a consistent copy.
DATA_PATH="/var/lib/examplechain/data"
SERVICE_NAME="examplechain.service"
SYSTEMCTL_COMMAND="systemctl"

# Separate local path owned by this tool. It is updated in-place with rsync,
# then transferred to a builder-managed location selected by the remote wrapper.
STAGING_PATH="/var/lib/cosmos-snapshots/examplechain/data"

# Local validation and staging policy. Required dirs must exist and look like
# Tendermint DBs; staged dirs are the only top-level entries copied. The tool
# allows only known public DB directories here, not snapshots, WALs, keys, or
# validator state files.
REQUIRED_DB_DIRS="application.db blockstore.db state.db"
STAGE_DB_DIRS="application.db blockstore.db state.db evidence.db tx_index.db"
DB_MARKER_PATTERNS="CURRENT MANIFEST-* *.sst *.ldb"
LOCAL_RSYNC_EXTRA_ARGS="--numeric-ids"

# SSH target for the builder over the VPN-bound host proxy.
BUILDER_SSH="snapupload@snapshot-builder.example"
BUILDER_SSH_PORT=2222
SSH_OPTIONS="-o BatchMode=yes"

# Builder restricted command. Host-side file locations are configured only on
# the builder and are not accepted from this client config.
REMOTE_COMMAND="cosmos-snapshot-remote"

# Optional local label. Production authorization should come from the builder's
# forced-command SSH key, not from a client-supplied value.
CLIENT_ID=""

# Rsync behavior.
RSYNC_DELETE=1
RSYNC_EXTRA_ARGS="--numeric-ids"

# Rsync verifies transferred file data and exits non-zero on transfer failure.
# The post-transfer dry-run below uses --checksum to catch any remaining drift;
# disable it only when the extra full-file scan is too expensive.
VERIFY_REMOTE_RSYNC=1

# Add --checksum to the transfer itself. This is slower but can detect content
# changes even when size and mtime match.
RSYNC_CHECKSUM=0

# Trigger builder-side finalization after a successful rsync.
RUN_FINALIZER=1

# Print commands without transferring or running remote commands.
DRY_RUN=0
