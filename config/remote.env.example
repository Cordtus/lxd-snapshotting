# Builder SSH wrapper config.
# Copy to /etc/cosmos-snapshot-remote.env in snap-builder.

INGEST_ROOT="/ingest"
ACCESS_CONFIG="/etc/cosmos-snapshot-access.json"
RSYNC_COMMAND="rsync"
FINALIZER_COMMAND="/usr/local/sbin/cosmos-snapshot-finalize --config /etc/cosmos-snapshot-finalizer.env"

# Testing only. Production identity comes from forced-command SSH.
ALLOW_CLIENT_ID_ARG=0
