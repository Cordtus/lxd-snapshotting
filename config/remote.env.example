# Builder-side SSH wrapper configuration.
#
# Copy to /etc/cosmos-snapshot-remote.env inside the snap-builder container.

INGEST_ROOT="/ingest"
ACCESS_CONFIG="/etc/cosmos-snapshot-access.json"
RSYNC_COMMAND="rsync"
FINALIZER_COMMAND="/usr/local/sbin/cosmos-snapshot-finalize --config /etc/cosmos-snapshot-finalizer.env"

# Set to 1 only for local testing without a forced-command SSH key. Production
# should identify the client through the forced command environment instead.
ALLOW_CLIENT_ID_ARG=0
